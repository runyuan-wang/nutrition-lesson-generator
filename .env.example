# Nutrition Lesson Generator — environment template
# The default `mock` mode is fully offline and requires no API key.

# Optional: provider selection (mock only in the current MVP)
# LESSON_PROVIDER=mock

# Optional: evidence source for `generate` (mock | pubmed)
# EVIDENCE_SOURCE=mock

# Optional: NCBI API key for higher-rate PubMed E-utilities access.
# Without a key the tool uses the public rate (≈3 requests/second).
# Get a key at https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=your_key_here

# Optional: real contact included in the descriptive NCBI User-Agent.
# NCBI_EMAIL=you@example.org

# Optional: output directory override
# LESSON_OUTPUT_DIR=output
